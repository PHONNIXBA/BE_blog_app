{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": ".dist-test",
        "declaration": false,
        "noEmitOnError": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "test/**/*.test.ts"],
    "exclude": ["node_modules", "dist", "dist-test", "**/*.spec.ts", "**/*e2e-spec.ts"]
}